{
  "name": "ahud",
  "version": "0.0.0-development",
  "description": "One terminal HUD for Codex and Claude Code",
  "type": "module",
  "bin": {
    "ahud": "./src/cli.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lbb00/ahud.git",
    "directory": "plugins/ahud"
  },
  "scripts": {
